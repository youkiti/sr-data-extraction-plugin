{
  "name": "sr-data-extraction-plugin",
  "version": "0.34.0",
  "private": true,
  "description": "SR のデータ抽出工程を支援する Chrome 拡張（AI 事前抽出 + 人間検証 + 監査証跡）",
  "license": "MIT",
  "engines": {
    "node": "^22.15.0 || >=24"
  },
  "scripts": {
    "dev": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "bundle:report": "node tools/bundle/sizeReport.mjs",
    "bundle:check": "node tools/bundle/checkBudget.mjs",
    "build:demo": "webpack --mode development --env demo",
    "check:tours": "node tools/guide-tour-check/run.mjs",
    "check:models": "node tools/weekly/checkModelIds.mjs",
    "release": "pwsh -NoProfile -File tools/release/release.ps1",
    "pack:release": "pwsh -NoProfile -File tools/release/pack.ps1",
    "deploy:pages": "node tools/pages/deployPages.mjs",
    "store:status": "node tools/release/storeApi.mjs status",
    "store:submit": "node tools/release/storeApi.mjs submit",
    "test:tools": "node --test tools/bundle/checkBudget.test.mjs tools/release/storeApi.test.mjs tools/help/listHelpGaps.test.mjs tools/changelog/checkAiChanges.test.mjs tools/changelog/stampChangelog.test.mjs tools/guide-tour-check/check.test.mjs video/scripts/tour-videos.test.mjs tools/weekly/checkModelIds.test.mjs tools/licenses/generateThirdPartyNotices.test.mjs tools/release/releaseMetadata.test.mjs tools/eslint/config.test.mjs",
    "facts": "node tools/facts/generateProjectFacts.mjs",
    "facts:check": "node tools/facts/generateProjectFacts.mjs --check",
    "licenses": "node tools/licenses/generateThirdPartyNotices.mjs",
    "licenses:check": "node tools/licenses/generateThirdPartyNotices.mjs --check",
    "help:gaps": "node tools/help/listHelpGaps.mjs",
    "changelog:check": "node tools/changelog/checkAiChanges.mjs",
    "help:shots": "node tools/help-shots/shoot.mjs",
    "diagram:data-flow": "node tools/data-flow/generate.mjs",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:css": "stylelint \"src/**/*.css\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "manual:check": "node tools/selenium/manualCheck.mjs",
    "video:setup": "bash video/scripts/setup.sh",
    "video:fixtures": "node video/fixtures/build-fixtures.mjs",
    "video:record": "node video/scripts/record.mjs",
    "video:tts": "node video/scripts/tts.mjs",
    "video:assemble": "node video/scripts/assemble.mjs",
    "video:tours": "node video/scripts/tour-videos.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/chrome": "^0.3.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "copy-webpack-plugin": "^14.0.0",
    "dotenv": "^18.0.10",
    "entities": "^6.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.6.2",
    "selenium-webdriver": "^4.45.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^40.0.0",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "webpack": "^5.108.3",
    "webpack-cli": "^7.3.1"
  },
  "dependencies": {
    "mammoth": "^1.12.0",
    "mermaid": "^11.16.0",
    "pdfjs-dist": "6.5.438",
    "zod": "^4.6.6"
  }
}
